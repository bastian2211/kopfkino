# Interner Webserver von Kopfkino: liefert die PWA aus und leitet /api an die API weiter.
# HTTPS und Zertifikate macht der vorgelagerte Caddy (gemeinsamer Eingang auf dem Server),
# deshalb hier nur HTTP auf Port 80 im Docker-Netzwerk, ohne eigene Zertifikate.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Kamera und Mikrofon nur für die eigene Seite erlauben
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv

		# Service Worker und Manifest nie lange cachen, sonst kommen Updates nicht an
		@nocache path /sw.js /registerSW.js /manifest.webmanifest /index.html /
		header @nocache Cache-Control "no-cache"

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
