# DOMAIN und ACME_EMAIL kommen aus der .env auf dem Server.
# Caddy holt das HTTPS-Zertifikat automatisch (Let's Encrypt).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Kamera und Mikrofon nur für die eigene Seite erlauben
		Permissions-Policy "camera=(self), microphone=(self), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv

		# Service Worker und Manifest nie lange cachen, sonst kommen Updates nicht an
		@nocache path /sw.js /registerSW.js /manifest.webmanifest /index.html /
		header @nocache Cache-Control "no-cache"

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"

		try_files {path} /index.html
		file_server
	}
}
