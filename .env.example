# Vorlage für /opt/kopfkino/.env auf dem Server. Die echte .env NIE ins Repo committen.

# Container-Images aus der GitHub Container Registry
IMAGE_PREFIX=ghcr.io/bastian2211
IMAGE_TAG=latest

# Datenbank (Passwort lang und zufällig, z. B. `openssl rand -hex 32`)
POSTGRES_USER=kopfkino
POSTGRES_PASSWORD=bitte-ersetzen
POSTGRES_DB=kopfkino

# Spätere Schritte (noch nicht genutzt):
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# STT_API_KEY=
# FILE_ENCRYPTION_KEY=

# Öffentliche Adresse (Einladungslinks, Herkunftsprüfung)
APP_URL=https://kopfkino.steinhose.de

# Web Push – NICHT von Hand ausdenken, sondern auf dem Server erzeugen:
#   docker compose exec -T api node dist/cli.js vapid >> .env && docker compose up -d api
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
